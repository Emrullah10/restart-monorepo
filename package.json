{
  "name": "teknolup-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core/*",
    "services/*",
    "packages/modules/*",
    "teknolup-web-app"
  ],
  "scripts": {
    "test": "node --test core/*/test/**/*.test.js services/*/test/**/*.test.js packages/modules/*/test/**/*.test.js",
    "dev:web": "npm run dev -w teknolup-web-app",
    "dev:iam": "npm run dev -w teknolup-service-iam",
    "dev:operation": "npm run dev -w teknolup-service-operation",
    "dev:marketplace": "npm run dev -w teknolup-service-marketplace",
    "dev:gateway": "npm run dev -w teknolup-web-gateway",
    "dev:mapi": "npm run dev -w teknolup-mapi-gateway",
    "build:web": "npm run build -w teknolup-web-app",
    "migrate": "node db-schemas/migrate.mjs",
    "seed": "node db-schemas/seed-random-demo.mjs",
    "seed:rich": "node db-schemas/seed-rich-demo.mjs",
    "start:web": "npm run start -w teknolup-web-app",
    "start:iam": "npm run start -w teknolup-service-iam",
    "start:operation": "npm run start -w teknolup-service-operation",
    "start:marketplace": "npm run start -w teknolup-service-marketplace",
    "start:gateway": "npm run start -w teknolup-web-gateway",
    "start:mapi": "npm run start -w teknolup-mapi-gateway"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
